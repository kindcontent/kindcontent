        <mxCell id="h2" parent="1" style="rounded=1;arcSize=6;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=16;spacingRight=12;spacingTop=12;fontFamily=Inter;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-size:13px;font-weight:bold;color:#EA580C;letter-spacing:1px&quot;&gt;NGƯỜI DUYỆT · TRƯỞNG NHÓM&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;color:#EA580C&quot;&gt;Duyệt đề xuất &amp;amp; giá&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#0F172A&quot;&gt;Trong 24 giờ, trước khi gửi khách&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;color:#475569&quot;&gt;Kiểm: đúng nhu cầu? giá đúng bảng? cam kết làm được?&lt;br&gt;Chưa đạt → Agent 9 sửa&lt;/span&gt;" vertex="1">
