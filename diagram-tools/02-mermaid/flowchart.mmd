---
title: Quy trình Agentic Content — Từ Chiến lược đến Thực thi và Phân phối
---
flowchart LR
    subgraph S1["🧭 GIAI ĐOẠN 1 — CHIẾN LƯỢC (Strategy)"]
        direction TB
        A1["<b>1. Agent Nghiên cứu</b><br/>phân tích thị trường, đối thủ,<br/>insight khách hàng"]
        A2["<b>2. Agent SEO & Từ khóa</b><br/>từ khóa, search intent,<br/>khoảng trống nội dung"]
        A3["<b>3. Agent Kế hoạch</b><br/>persona, content pillar,<br/>lịch nội dung"]
        H1{{"👤 <b>4. Người duyệt<br/>chiến lược</b>"}}
        A1 --> A2 --> A3 --> H1
    end

    subgraph S2["✍️ GIAI ĐOẠN 2 — THỰC THI (Execution)"]
        direction TB
        B5["<b>5. Agent Brief</b><br/>dàn ý, outline,<br/>thông điệp chính"]
        B6["<b>6. Agent Viết</b><br/>bản nháp blog,<br/>fanpage, PR"]
        B7["<b>7. Agent Hình ảnh & Video</b><br/>visual, thumbnail,<br/>kịch bản video ngắn"]
        B8["<b>8. Agent Biên tập</b><br/>SEO on-page, kiểm chứng,<br/>giọng thương hiệu"]
        H2{"👤 <b>9. Người duyệt<br/>nội dung</b><br/>Đạt chưa?"}
        B5 --> B6 --> B7 --> B8 --> H2
        H2 -- "❌ Chưa đạt → sửa lại" --> B6
    end

    subgraph S3["📣 GIAI ĐOẠN 3 — PHÂN PHỐI (Distribution)"]
        direction TB
        C10["<b>10. Agent Chuyển thể</b><br/>1 bài gốc → nhiều định dạng<br/>(post, reel, email)"]
        C11["<b>11. Agent Đăng bài</b><br/>lên lịch & đăng: Website, Fanpage,<br/>TikTok, YouTube, Email"]
        C12["<b>12. Agent Đo lường</b><br/>traffic, tương tác,<br/>chuyển đổi"]
        C10 --> C11 --> C12
    end

    S1 == "✅ Chiến lược được duyệt" ==> S2
    S2 == "✅ Nội dung đạt" ==> S3
    S1 <-. "🔁 Kết quả đo lường → tối ưu chu kỳ sau" .- S3

